    "nome": {
      "type": "string",
      "description": "Nome da congregação"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade onde a congregação está localizada"
    },
    "estado": {
      "type": "string",
      "description": "Estado"
    },
    "endereco": {
      "type": "string",
      "description": "Endereço completo"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "pastor_responsavel": {
      "type": "string",

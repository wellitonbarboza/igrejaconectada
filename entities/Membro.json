{
  "name": "Membro",
  "type": "object",
  "properties": {
    "nome_completo": {
      "type": "string",
      "description": "Nome completo do membro"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "membro",
        "congregado",
        "visitante",
        "crianca"
      ],
      "default": "congregado",
      "description": "Tipo de vínculo com a igreja"
    },
    "origem": {
      "type": "string",
      "enum": [
        "novo",
        "transferencia"
      ],
      "default": "novo",
      "description": "Se é novo convertido ou vem por transferência"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo",
        "transferido"
      ],
      "default": "ativo",
      "description": "Status atual do membro"
    },
    "congregacao_id": {
      "type": "string",
      "description": "ID da congregação"
    },
    "congregacao_nome": {
      "type": "string",
      "description": "Nome da congregação"
    },
    "data_nascimento": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento"
    },
    "cpf": {
      "type": "string",
      "description": "CPF"
    },
    "rg": {
      "type": "string",
      "description": "RG"
    },
    "sexo": {
      "type": "string",
      "enum": [
        "masculino",
        "feminino"
      ],
      "description": "Sexo"
    },
    "estado_civil": {
      "type": "string",
      "enum": [
        "solteiro",
        "casado",
        "divorciado",
        "viuvo"
      ],
      "description": "Estado civil"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone principal"
    },
    "telefone_secundario": {
      "type": "string",
      "description": "Telefone secundário"
    },
    "email": {
      "type": "string",
      "description": "Email"
    },
    "endereco": {
      "type": "string",
      "description": "Endereço completo"
    },
    "bairro": {
      "type": "string",
      "description": "Bairro"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade"
    },
    "estado": {
      "type": "string",
      "description": "Estado"
    },
    "cep": {
      "type": "string",
      "description": "CEP"
    },
    "data_batismo": {
      "type": "string",
      "format": "date",
      "description": "Data do batismo nas águas"
    },
    "local_batismo": {
      "type": "string",
      "description": "Local onde foi realizado o batismo"
    },
    "batismo_espirito_santo": {
      "type": "boolean",
      "default": false,
      "description": "Se recebeu o batismo com Espírito Santo"
    },
    "data_batismo_espirito_santo": {
      "type": "string",
      "format": "date",
      "description": "Data do batismo com Espírito Santo"
    },
    "obreiro": {
      "type": "boolean",
      "default": false,
      "description": "Se é obreiro"
    },
    "cargo_obreiro": {
      "type": "string",
      "enum": [
        "cooperador",
        "diacono",
        "presbitero",
        "evangelista",
        "pastor"
      ],
      "description": "Cargo do obreiro"
    },
    "departamento_id": {
      "type": "string",
      "description": "ID do departamento que pertence"
    },
    "departamento_nome": {
      "type": "string",
      "description": "Nome do departamento"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto do membro"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações gerais"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o membro está ativo"
    },
    "foto_path": {
      "type": "string",
      "description": "Caminho da foto no storage"
    },
    "foto_bucket": {
      "type": "string",
      "description": "Bucket da foto do membro"
    }
  },
  "required": [
    "nome_completo",
    "congregacao_id"
  ]
}
